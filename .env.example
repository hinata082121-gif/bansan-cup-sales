# Supabase（ダッシュボードの Project Settings → API Keys / Data API で確認）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable key（sb_publishable_...）。旧形式の anon key でも動く
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# 店舗データの投入（npm run stores:sync / stores:upsert）でのみ使う。Vercel には設定しない
# Secret key（sb_secret_...）。旧形式の service_role key でも動く
SUPABASE_SECRET_KEY=
